{
  "name": "wdio-cucumber-ts-framework",
  "version": "1.0.0",
  "description": "WebdriverIO v9 TypeScript Cucumber Framework",
  "type": "module",
  "scripts": {
    "test": "wdio run wdio.conf.ts",
    "login": "set HEADLESS=N && npx wdio wdio.conf.ts --cucumberOpts.tagExpression=@login",
    "validLogin": "set HEADLESS=N && npx wdio wdio.conf.ts --cucumberOpts.tagExpression=@validLogin",
    "call": "set HEADLESS=N && npx wdio wdio.conf.ts --cucumberOpts.tagExpression=@call",
    "getUsers": "set HEADLESS=N && npx wdio wdio.conf.ts --cucumberOpts.tagExpression=@getUsers",
    "createUser": "set HEADLESS=N && npx wdio wdio.conf.ts --cucumberOpts.tagExpression=@createUser",
    "deleteUser": "set HEADLESS=N && npx wdio wdio.conf.ts --cucumberOpts.tagExpression=@deleteUser",
    "flipkartE2E": "set HEADLESS=N && npx wdio wdio.conf.ts --cucumberOpts.tagExpression=@flipkartE2E",
    "smoke": "set HEADLESS=N && npx wdio wdio.conf.ts --cucumberOpts.tagExpression=@smoke",
    "Regression": "set HEADLESS=N && npx wdio wdio.conf.ts --cucumberOpts.tagExpression=@Regression"



  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.3.1",
    "@types/node": "^20.11.0",
    "@types/supertest": "^7.2.0",
    "@wdio/allure-reporter": "^9.27.1",
    "@wdio/cli": "^9.27.1",
    "@wdio/cucumber-framework": "^9.27.1",
    "@wdio/globals": "^9.27.1",
    "@wdio/local-runner": "^9.27.1",
    "allure-commandline": "^2.41.0",
    "dotenv": "^17.4.2",
    "geckodriver": "^6.1.0",
    "supertest": "^7.2.2",
    "tsx": "^4.7.2",
    "typescript": "^5.3.3",
    "winston": "^3.19.0"
  },
  "dependencies": {
    "chromedriver": "^147.0.1",
    "ts-node": "^10.9.2"
  }
}
